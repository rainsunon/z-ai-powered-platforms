{
  "name": "food-delivery-api-gateway-cdk",
  "version": "1.0.0",
  "description": "AWS CDK infrastructure for Food Delivery API Gateway and S3",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
