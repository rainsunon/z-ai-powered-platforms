# Notification Service

PORT=3051
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgres://vive_notif:change_me_in_production@localhost:5432/vive_notif

# RabbitMQ (use amqps:// in production)
RABBITMQ_URL=amqp://vive_rmq:change_me_in_production@localhost:5672

# Redis (use rediss:// in production)
REDIS_URL=redis://:change_me_in_production@localhost:6379

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@vive-wellbeing.com

# Worker
MAX_RETRIES=3
RATE_LIMIT_PER_MINUTE=5
WORKER_HEALTH_PORT=3002

# API Authentication (required — generate a strong random key)
API_KEY=your-api-key-here

# HTTP rate limiting (requests per minute per caller)
HTTP_RATE_LIMIT_PER_MINUTE=100
