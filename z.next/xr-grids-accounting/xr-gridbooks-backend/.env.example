# Copy this file to .env and fill in your actual values

# Database - Get this from your Supabase project settings
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:[PORT]/postgres?schema=public"

# Supabase - Get these from your Supabase project settings > API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Better Auth - Generate a random 32+ character string
AUTH_SECRET="generate-a-random-secret-key-min-32-chars-long-use-openssl-rand-base64-32"
AUTH_URL="http://localhost:4000"

# JWT - Generate a random 32+ character string
JWT_SECRET="generate-another-random-secret-key-min-32-chars-use-openssl-rand-base64-32"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
NODE_ENV="development"

# CORS - Update this to match your frontend URL
CORS_ORIGIN="http://localhost:5173"
