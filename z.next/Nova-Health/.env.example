# ============================================
# Nova Health Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# ============================================
# Node Environment
# ============================================
NODE_ENV=development
PORT=3000
SERVICE_NAME=nova-health-service

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/nova_health
DATABASE_POOL_SIZE=10

# ============================================
# JWT Configuration
# ============================================
# Generate a secure random string for JWT_SECRET
# Example: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# Stripe Configuration (Optional)
# ============================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ============================================
# Email Configuration (SMTP)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@novahealth.com

# ============================================
# Kafka Configuration (Optional)
# ============================================
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=nova-health-service
KAFKA_GROUP_ID=nova-health-group

# ============================================
# Redis Configuration (Optional - for caching)
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your-redis-password

# ============================================
# S3 / Object Storage Configuration (Optional)
# ============================================
S3_BUCKET=nova-health-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key

# ============================================
# CORS Configuration
# ============================================
# Use '*' for development, specific origins for production
CORS_ORIGIN=*

# ============================================
# Service-Specific Ports
# ============================================
# Admin Service
ADMIN_SERVICE_PORT=3001

# Auth Service
AUTH_SERVICE_PORT=3002

# Billing Service
BILLING_SERVICE_PORT=3003

# Customer Service
CUSTOMER_SERVICE_PORT=3004

# Notification Service
NOTIFICATION_SERVICE_PORT=3005

# Order Service
ORDER_SERVICE_PORT=3006

# Payment Service
PAYMENT_SERVICE_PORT=3007

# Sync Service
SYNC_SERVICE_PORT=3008

# Analytics Service
ANALYTICS_SERVICE_PORT=3009

# Symptom Service
SYMPTOM_SERVICE_PORT=3010

# ============================================
# Monitoring & Observability (Optional)
# ============================================
# Prometheus
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# ============================================
# Feature Flags
# ============================================
FEATURE_EMAIL_NOTIFICATIONS=true
FEATURE_SMS_NOTIFICATIONS=true
FEATURE_PUSH_NOTIFICATIONS=false
FEATURE_ANALYTICS=true
FEATURE_RATE_LIMITING=true
