{
  "name": "@nova-health/kafka",
  "version": "1.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "import": "./src/client.ts"
    },
    "./producers/*": {
      "types": "./src/producers/*.ts",
      "import": "./src/producers/*.ts"
    },
    "./consumers/*": {
      "types": "./src/consumers/*.ts",
      "import": "./src/consumers/*.ts"
    }
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "~5.8.2",
    "@types/node": "^22.10.2"
  },
  "dependencies": {
    "kafkajs": "^2.2.4"
  }
}
