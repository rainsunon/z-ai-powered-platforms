{
  "info": {
    "name": "Outbox Publisher Demo",
    "_postman_id": "b2cf1b7d-6c0a-4c3a-9c48-42b1c5502f2f",
    "description": "Transactional Outbox demo: orders API + outbox admin endpoint.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerEmail\": \"john.doe@example.com\",\n  \"totalAmount\": 123.45\n}\n"
        }
      }
    },
    {
      "name": "Get Order By Id",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/orders/{{orderId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders",
            "{{orderId}}"
          ]
        }
      }
    },
    {
      "name": "List Stuck Outbox Rows",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/admin/outbox/stuck",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "outbox",
            "stuck"
          ]
        }
      }
    },
    {
      "name": "List Stuck Outbox Rows (olderThan=PT2M)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/admin/outbox/stuck?olderThan=PT2M",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "outbox",
            "stuck"
          ],
          "query": [
            {
              "key": "olderThan",
              "value": "PT2M"
            }
          ]
        }
      }
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Search Orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders/search?q=john&page=0&size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "john"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}