# General
.DS_Store # macOS specific file
Thumbs.db # Windows specific file
.idea/ # IntelliJ IDEA specific directory
.vscode/ # VS Code specific directory
*.log # Log files
*.tmp # Temporary files
*.swp # Vim swap files

# Java
# Compiled class files and build artifacts
*.class
*.jar
*.war
*.ear
/target/ # Maven build output directory
/build/ # Gradle build output directory
# VM crash logs
hs_err_pid*

# Python
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
# Virtual environment
.env
/venv/
# Packaging
*.egg-info/
/dist/
/build/
# Test coverage
.coverage
.pytest_cache/

# JavaScript and TypeScript (Node.js/Frontend projects)
# Dependencies
/node_modules/
# Build artifacts
/dist/
/build/
# Compiled JS files from TypeScript sources
# (Only ignore if they are generated during build and not meant for source control)
*.js.map
# npm debug logs
npm-debug.log*
yarn-debug.log*

yarn-error.log*
# Next.js/SvelteKit build folders
.next/
.svelte-kit/
