# Optional.
# Two supported dev setups:
#
# A) Recommended (most stable): use Vite proxy and call the UI as /api/... (default).
#    Configure the proxy target here (IPv4 loopback avoids `localhost` IPv6 stalls).
VITE_PROXY_TARGET=http://127.0.0.1:8080

# B) Direct calls from browser (no Vite proxy). Requires backend CORS to allow http://localhost:5173.
#    If set, axios will call the backend directly.
VITE_API_BASE_URL=http://127.0.0.1:8080
